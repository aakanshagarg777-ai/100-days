#include <stdio.h>
#include <string.h>

int count_char_frequency(const char *str, char ch) {
    int count = 0;
    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] == ch) {
            count++;
        }
    }
    return count;
}

int main() {
    printf("String: \"hello world\"\n");
    printf("Character: 'l'\n");
    printf("Frequency: %d\n", count_char_frequency("hello world", 'l'));
    
    printf("\nString: \"programming\"\n");
    printf("Character: 'p'\n");
    printf("Frequency: %d\n", count_char_frequency("programming", 'p'));
    
    return 0;
}
